# Copie este arquivo para ".env.local" e preencha os valores.
# NUNCA envie o .env.local para o GitHub.

# --- Supabase (Project Settings > API) ---
# Estas duas são públicas por desenho: a proteção dos dados vem das políticas RLS do banco.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endereço do site (usado nos links de e-mail). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Assistente de IA (SOMENTE servidor; nunca coloque NEXT_PUBLIC_ aqui) ---
# Deixe vazio para usar o MODO DEMONSTRATIVO (sem IA real).
# AI_PROVIDER: "anthropic" ou "openai"
AI_PROVIDER=
AI_API_KEY=
# Opcional. Se vazio, usa um modelo padrão do provedor.
AI_MODEL=
